# -----------------------------------------------------------------------------
# OmniFlux build-time configuration
#
# Copy to `.env` and fill in only what you need; every key is optional, and a
# missing key just turns that feature off. `.env` is gitignored: never commit it.
#
# Every MAIN_VITE_* value is compiled into the app, and anyone can extract it
# from the installer. Put nothing here that must stay secret, and restrict each
# key on the provider's side (API restrictions, quotas).
# -----------------------------------------------------------------------------

# --- Movie & TV metadata: posters, summaries, trending -----------------------
# https://www.themoviedb.org/settings/api  (API key or read access token)
MAIN_VITE_TMDB_KEY=

# --- Google Drive: stream from folders the user adds -------------------------
# Google Cloud Console -> APIs & Services -> enable "Google Drive API"
#   Credentials -> OAuth client ID -> Application type: Desktop app
# (Google documents Desktop client secrets as non-confidential.)
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
# Credentials -> API key (restrict it to Drive API + YouTube Data API v3)
MAIN_VITE_GOOGLE_API_KEY=

# --- YouTube: music search, trending, public playlists -----------------------
# Same Google Cloud project -> enable "YouTube Data API v3" -> API key.
# Default quota: 10,000 units/day for the whole project (1 search = 100).
MAIN_VITE_YOUTUBE_API_KEY=

# --- Spotify: sign-in and playback (Premium) ---------------------------------
# https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:8888/callback   APIs: Web API, Web Playback SDK
# PKCE only: no client secret is needed or used.
# Development-mode apps only work for accounts you add under "User Management".
MAIN_VITE_SPOTIFY_CLIENT_ID=

# --- Deezer: full-track playback for Premium users (optional) ----------------
# Without it, search and 30-second previews still work.
MAIN_VITE_DEEZER_APP_ID=

# --- Optional helpers --------------------------------------------------------
# Programmable Search Engine ID (cx), for posters of titles that TMDB lacks
MAIN_VITE_GOOGLE_CSE_ID=
# Groq API key, for cleaning up file names the parser can't read (https://console.groq.com)
MAIN_VITE_GROQ_KEY=
# SubDL subtitle search (https://subdl.com/panel/api). Read at runtime, not compiled in.
SUBDL_API_KEY=

# --- Build & signing (not compiled into the app) -----------------------------
# castlabs EVS account, for VMP-signing production builds (Spotify needs this).
# See https://github.com/castlabs/electron-releases/wiki/EVS.
# Or set OMNIFLUX_SKIP_VMP=1 to build without it.
# EVS_ACCOUNT_NAME=
# EVS_PASSWD=
